<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="urn:company:integration:meter:replacement:v1"
    targetNamespace="urn:company:integration:meter:replacement:v1"
    name="MeterReplacementService">

  <wsdl:documentation>
    Synchronous meter replacement request and response.
    Replace the example namespace and SOAP endpoint with the values agreed for your integration.
  </wsdl:documentation>

  <wsdl:types>
    <xsd:schema
        targetNamespace="urn:company:integration:meter:replacement:v1"
        elementFormDefault="qualified">

      <xsd:simpleType name="Char10">
        <xsd:restriction base="xsd:string">
          <xsd:maxLength value="10"/>
        </xsd:restriction>
      </xsd:simpleType>
      <xsd:simpleType name="Char12">
        <xsd:restriction base="xsd:string">
          <xsd:maxLength value="12"/>
        </xsd:restriction>
      </xsd:simpleType>
      <xsd:simpleType name="Char30">
        <xsd:restriction base="xsd:string">
          <xsd:maxLength value="30"/>
        </xsd:restriction>
      </xsd:simpleType>
      <xsd:simpleType name="Char1">
        <xsd:restriction base="xsd:string">
          <xsd:maxLength value="1"/>
        </xsd:restriction>
      </xsd:simpleType>
      <xsd:simpleType name="Char20">
        <xsd:restriction base="xsd:string">
          <xsd:maxLength value="20"/>
        </xsd:restriction>
      </xsd:simpleType>
      <xsd:simpleType name="Char50">
        <xsd:restriction base="xsd:string">
          <xsd:maxLength value="50"/>
        </xsd:restriction>
      </xsd:simpleType>
      <xsd:simpleType name="Char100">
        <xsd:restriction base="xsd:string">
          <xsd:maxLength value="100"/>
        </xsd:restriction>
      </xsd:simpleType>
      <xsd:simpleType name="Char300">
        <xsd:restriction base="xsd:string">
          <xsd:maxLength value="300"/>
        </xsd:restriction>
      </xsd:simpleType>
      <xsd:simpleType name="DateYYYYMMDD">
        <xsd:restriction base="xsd:string">
          <xsd:length value="8"/>
          <xsd:pattern value="[0-9]{8}"/>
        </xsd:restriction>
      </xsd:simpleType>
      <xsd:simpleType name="Decimal15">
        <xsd:restriction base="xsd:decimal">
          <xsd:totalDigits value="15"/>
        </xsd:restriction>
      </xsd:simpleType>

      <xsd:element name="MeterReplacementRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="PARTNER" type="tns:Char10"/>
            <xsd:element name="CONTRACT_NUMBER" type="tns:Char12"/>
            <xsd:element name="OLD_METER_SERIAL_NO" type="tns:Char30"/>
            <xsd:element name="OLD_METER_REPL_DATE" type="tns:DateYYYYMMDD"/>
            <xsd:element name="OLD_METER_REPL_READ" type="tns:Decimal15"/>
            <xsd:element name="OLD_METER_BALANCE" type="tns:Decimal15"/>
            <xsd:element name="NEW_METER_SERIAL_NO" type="tns:Char30"/>
            <xsd:element name="NEW_METER_READ" type="tns:Decimal15"/>
            <xsd:element name="IS_REPLACED" type="tns:Char1"/>
            <xsd:element name="REASON" type="tns:Char300"/>
            <xsd:element name="STATUS" type="tns:Char1"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="MeterReplacementResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="PARTNER" type="tns:Char10"/>
            <xsd:element name="CONTRACT_NUMBER" type="tns:Char12"/>
            <xsd:element name="OLD_METER_SERIAL_NO" type="tns:Char30"/>
            <xsd:element name="STATUS" type="tns:Char20"/>
            <xsd:element name="ERROR" type="tns:Char50"/>
            <xsd:element name="ERROR_CODE" type="tns:Char1"/>
            <xsd:element name="MESSAGE" type="tns:Char100"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

    </xsd:schema>
  </wsdl:types>

  <wsdl:message name="MeterReplacementRequestMessage">
    <wsdl:part name="parameters" element="tns:MeterReplacementRequest"/>
  </wsdl:message>
  <wsdl:message name="MeterReplacementResponseMessage">
    <wsdl:part name="parameters" element="tns:MeterReplacementResponse"/>
  </wsdl:message>

  <wsdl:portType name="MeterReplacementPortType">
    <wsdl:operation name="SubmitMeterReplacement">
      <wsdl:input message="tns:MeterReplacementRequestMessage"/>
      <wsdl:output message="tns:MeterReplacementResponseMessage"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="MeterReplacementSOAPBinding" type="tns:MeterReplacementPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="SubmitMeterReplacement">
      <soap:operation soapAction="urn:company:integration:meter:replacement:v1:SubmitMeterReplacement"/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="MeterReplacementService">
    <wsdl:port name="MeterReplacementSOAPPort" binding="tns:MeterReplacementSOAPBinding">
      <!-- Replace this example endpoint with the deployed SAP CPI SOAP sender endpoint. -->
      <soap:address location="https://cpi-non-production-jf51drao.it-cpi021-rt.cfapps.in30.hana.ondemand.com/cxf/MeterReplacement"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
